{
  config,
  lib,
  pkgs,
  ...
}:

let
  # Run a package's binaries on the NVIDIA GPU (what `nvidia-offload` does),
  # so its launcher entry uses it too. Left untouched when the NVIDIA driver is
  # absent (the "battery" boot entry), where these variables would break GLX.
  onNvidia =
    pkg:
    if !(lib.elem "nvidia" config.services.xserver.videoDrivers) then
      pkg
    else
      pkgs.symlinkJoin {
        name = "${pkg.name}-nvidia-offload";
        paths = [ pkg ];
        nativeBuildInputs = [ pkgs.makeWrapper ];
        postBuild = ''
          for bin in "$out"/bin/*; do
            wrapProgram "$bin" \
              --set __NV_PRIME_RENDER_OFFLOAD 1 \
              --set __NV_PRIME_RENDER_OFFLOAD_PROVIDER NVIDIA-G0 \
              --set __GLX_VENDOR_LIBRARY_NAME nvidia \
              --set __VK_LAYER_NV_optimus NVIDIA_only
          done
        '';
      };
in
{
  imports = [
    # Generated by nixos-generate-config; hand-written hardware settings live here instead.
    ./hardwareconfig.nix
  ];

  # Bootloader: GRUB on EFI (os-prober finds the Windows install).
  boot.loader.grub.enable = true;
  boot.loader.grub.device = "nodev";
  boot.loader.grub.efiSupport = true;
  boot.loader.grub.useOSProber = true;
  boot.loader.efi.canTouchEfiVariables = true;
  boot.loader.efi.efiSysMountPoint = "/boot";

  # Unlock the root LUKS volume with a FIDO2 key (YubiKey). Enrol the key
  # once with:
  #   sudo systemd-cryptenroll --fido2-device=auto /dev/nvme0n1p2
  # The passphrase slot stays: without the key plugged in, the prompt falls
  # back to it after token-timeout.
  boot.initrd.luks.devices."luks-f770aee4-e041-4300-8c07-cedc2baa51b2".crypttabExtraOpts = [
    "fido2-device=auto"
    "token-timeout=15"
  ];

  # Default (LTS) kernel: the legacy NVIDIA driver below lags behind the newest kernels.

  hardware.cpu.intel.updateMicrocode = true;
  services.fwupd.enable = true;

  networking.hostName = "pennyix";
  networking.networkmanager.enable = true;
  services.printing.enable = true;

  time.timeZone = "America/New_York";

  i18n.defaultLocale = "en_US.UTF-8";
  i18n.extraLocaleSettings = {
    LC_ADDRESS = "en_US.UTF-8";
    LC_IDENTIFICATION = "en_US.UTF-8";
    LC_MEASUREMENT = "en_US.UTF-8";
    LC_MONETARY = "en_US.UTF-8";
    LC_NAME = "en_US.UTF-8";
    LC_NUMERIC = "en_US.UTF-8";
    LC_PAPER = "en_US.UTF-8";
    LC_TELEPHONE = "en_US.UTF-8";
    LC_TIME = "en_US.UTF-8";
  };

  # Graphics: Intel UHD 630 drives the panel, the GTX 1050 Ti Max-Q is used on
  # demand (`nvidia-offload <program>`) and for the external outputs.
  hardware.graphics.enable = true;
  # VA-API video decode on the Intel GPU (browsers, Discord, mpv) instead of the CPU.
  hardware.graphics.extraPackages = [ pkgs.intel-media-driver ];
  environment.sessionVariables.LIBVA_DRIVER_NAME = "iHD";
  services.xserver.videoDrivers = [ "nvidia" ];
  hardware.nvidia = {
    # Pascal cards were dropped from the mainline driver after the 580 branch.
    package = config.boot.kernelPackages.nvidiaPackages.legacy_580;
    open = false; # the open kernel modules need Turing or newer
    modesetting.enable = true;
    nvidiaSettings = true;
    # Save/restore GPU state across suspend. (Fine-grained runtime power-off
    # also needs Turing or newer, so it is not enabled.)
    powerManagement.enable = true;
    prime = {
      offload.enable = true;
      offload.enableOffloadCmd = true;
      intelBusId = "PCI:0:2:0";
      nvidiaBusId = "PCI:1:0:0";
    };
  };

  # Power management.
  services.upower.enable = true;
  services.power-profiles-daemon.enable = true;
  services.thermald.enable = true;
  # Runs `powertop --auto-tune` at boot: runtime PM for PCI/USB devices, SATA
  # link PM, audio codec power-down. If a USB input device gets laggy, this is
  # the option to drop.
  powerManagement.powertop.enable = true;
  networking.networkmanager.wifi.powersave = true;
  boot.kernel.sysctl."kernel.nmi_watchdog" = 0;
  # Let PCIe links (NVMe, wifi) use the deepest ASPM states the firmware allows.
  boot.kernelParams = [ "pcie_aspm.policy=powersupersave" ];

  # "battery" boot entry: the NVIDIA card stays powered on in the default
  # system (kwin keeps it open for the external outputs, and Pascal cannot
  # runtime-suspend while in use). This entry never loads a driver for it and
  # removes it from the PCI bus so it can power down. Cost: no DP/HDMI outputs
  # and no `nvidia-offload` until the next boot into the default entry.
  specialisation.battery.configuration = {
    system.nixos.tags = [ "battery" ];
    services.xserver.videoDrivers = lib.mkForce [ "modesetting" ];
    boot.blacklistedKernelModules = [
      "nouveau"
      "nvidia"
      "nvidia_drm"
      "nvidia_modeset"
      "nvidia_uvm"
    ];
    services.udev.extraRules = ''
      # NVIDIA HDMI audio function
      ACTION=="add", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{class}=="0x040300", ATTR{power/control}="auto", ATTR{remove}="1"
      # NVIDIA VGA/3D controller
      ACTION=="add", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{class}=="0x03[0-9]*", ATTR{power/control}="auto", ATTR{remove}="1"
    '';
  };
  # Encrypted swap on nvme0n1p3, re-keyed with a throwaway random key on every
  # boot: nothing readable is ever left on disk. This overwrites the partition
  # each boot and rules out hibernation (the key is gone after power-off).
  swapDevices = [
    {
      device = "/dev/disk/by-partuuid/9751999b-b911-4e0c-8164-cb51c923b696";
      randomEncryption.enable = true;
    }
  ];

  services.libinput.enable = true;

  hardware.bluetooth.enable = true;
  hardware.bluetooth.powerOnBoot = false;

  # udev rules + the plugdev group for RTL-SDR dongles (sdrpp, gnuradio).
  hardware.rtl-sdr.enable = true;

  security.rtkit.enable = true;

  # Fingerprint reader (Synaptics 06cb:009a) via open-fprintd + python-validity.
  # Enroll with `fprintd-enroll` after rebuilding.
  services."06cb-009a-fingerprint-sensor" = {
    enable = true;
    backend = "python-validity";
  };

  security.pam.services = {
    # plasma-login-manager substacks "login", so this covers the greeter and TTYs.
    # Note: a fingerprint login can't unlock KWallet (it needs the password).
    login.fprintAuth = true;
    sudo.fprintAuth = true;
    # Lock screen fingerprint; Plasma only defines this when services.fprintd is on.
    kde-fingerprint.fprintAuth = true;
    # Polkit prompts (e.g. KeePassXC quick unlock) accept the fingerprint too.
    polkit-1.fprintAuth = true;
  };

  # KWallet doesn't ship a D-Bus activation file for the Secret Service name.
  services.dbus.packages = [
    (pkgs.writeTextDir "share/dbus-1/services/org.freedesktop.secrets.service" ''
      [D-BUS Service]
      Name=org.freedesktop.secrets
      Exec=${pkgs.kdePackages.kwallet}/bin/ksecretd
    '')
  ];

  # SSH keys live in ssh-agent; the passphrase is asked for in the terminal on
  # first use and the key stays loaded for the rest of the session.
  programs.ssh.startAgent = true;
  programs.ssh.extraConfig = ''
    AddKeysToAgent yes
  '';
  # No graphical askpass: plasma6 would otherwise set SSH_ASKPASS to ksshaskpass.
  programs.ssh.enableAskPassword = false;
  environment.plasma6.excludePackages = [ pkgs.kdePackages.ksshaskpass ];

  programs.gnupg.agent = {
    enable = true;
    # SSH is handled by ssh-agent (see programs.ssh above).
    enableSSHSupport = false;
  };

  # Smartcard daemon: gpg (scdaemon) and ykman talk to the YubiKey's OpenPGP
  # applet through it.
  services.pcscd.enable = true;

  services.pipewire = {
    enable = true;
    alsa.enable = true;
    alsa.support32Bit = true;
    pulse.enable = true;
  };

  users.users.penny = {
    isNormalUser = true;
    description = "penny";
    extraGroups = [
      "networkmanager"
      "wheel"
      "plugdev"
      "wireshark"
    ];
    shell = pkgs.zsh;
    packages = with pkgs; [
      orca-slicer
      calibre
      firefox-esr
      unzip
      rpi-imager
      claude-code
      (onNvidia runelite)
      (onNvidia bolt-launcher)
      gimp
      discord
      # Binary Ninja Personal, built from the licensed installer.
      (pkgs.callPackage ../../pkgs/binary-ninja.nix { })
    ];
  };

  programs.zsh.enable = true;

  # Plasma 6 with its default display manager.
  services.desktopManager.plasma6.enable = true;
  services.displayManager.plasma-login-manager.enable = true;
  services.xserver.enable = true;

  # User-level tools (neovim, wget, ...) come from home.nix.
  environment.systemPackages = with pkgs; [
    lshw
    # Must be in the system profile, not the user one: polkit only reads
    # actions from /run/current-system/sw/share/polkit-1, and KeePassXC's
    # quick unlock needs its org.keepassxc.KeePassXC.unlockDatabase action.
    keepassxc
  ];

  programs.steam.enable = true;
  # `gamemoderun <game>` (Steam: `gamemoderun nvidia-offload %command%`).
  programs.gamemode.enable = true;
  programs.mtr.enable = true;

  # Installs the GUI plus a setcap'd dumpcap usable by the wireshark group.
  programs.wireshark = {
    enable = true;
    package = pkgs.wireshark;
  };

  # Daemon + CLI; the bare `mullvad` package can't do anything without the daemon.
  services.mullvad-vpn.enable = true;

  fonts.fontconfig.enable = true;
  fonts.packages = with pkgs; [
    nerd-fonts.ubuntu-sans
    nerd-fonts.jetbrains-mono
    nerd-fonts.fira-code
    atkinson-hyperlegible-mono # Ghostty's font (home.nix)
  ];
  fonts.fontconfig.defaultFonts.monospace = [
    "UbuntuSansMono Nerd Font"
  ];

  # DNS: everything goes through Tor's resolver, cached by systemd-resolved.
  services.tor = {
    enable = true;
    client.dns.enable = true;
    settings.DNSPort = [
      {
        addr = "127.0.0.1";
        port = 53;
      }
    ];
  };
  services.resolved = {
    enable = true;
    # No clearnet fallback: if Tor is down, lookups fail instead of leaking.
    fallbackDns = [ ];
  };
  networking.nameservers = [ "127.0.0.1" ];
  # Keep NetworkManager from handing each link's DHCP DNS servers to
  # systemd-resolved: resolved queries per-link servers alongside the global
  # one, which sent lookups to the router in the clear.
  networking.networkmanager.dns = lib.mkForce "none"; # resolved's module sets "systemd-resolved"

  nixpkgs.config.allowUnfree = true;
  nix.package = pkgs.lixPackageSets.lix_2_96.lix; # same Lix as the Mac
  nix.settings.sandbox = true;
  nix.settings.experimental-features = [
    "nix-command"
    "flakes"
  ];

  # The release this system was first installed with. Do not bump it on upgrades;
  # it only controls defaults for stateful data.
  system.stateVersion = "26.05";
}
